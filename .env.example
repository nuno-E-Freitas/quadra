# Either a Neon connection string (the -pooler host, sslmode=require) …
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# … or local Postgres from docker-compose.yml — `pnpm db:up`.
# Host port 5434: 5432 and 5433 are already taken on this machine.
# DATABASE_URL="postgres://quadra:quadra@localhost:5434/quadra"
